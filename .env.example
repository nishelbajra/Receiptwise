# ===========================================
# RECEIPTWISE ENVIRONMENT CONFIGURATION
# ===========================================

# Database (Required)
# For local: postgresql://user@localhost:5432/receiptwise
# For Neon: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/receiptwise
DATABASE_URL=""

# NextAuth.js (Required)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Optional)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================
# AI RECEIPT SCANNING - Choose ONE option
# ===========================================

# OPTION 1: Gemini API (Recommended for deployment)
# Get free key from: https://aistudio.google.com/app/apikey
# Free tier: 1,500 requests/day
GEMINI_API_KEY=""

# OPTION 2: Local AI (For development only)
# Requires running Ollama and OCR service locally
# OCR_SERVICE_URL="http://localhost:8000"
# OLLAMA_HOST="http://localhost:11434"
# OLLAMA_MODEL="qwen3:4b"

# ===========================================
# Storage (For local development)
# ===========================================
STORAGE_DIR="./storage/receipts"
