# Database
DATABASE_URL="postgresql://username:password@localhost:5432/receiptwise?schema=public"

# NextAuth.js
NEXTAUTH_SECRET="your-secret-key-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Local OCR service (Python + Tesseract)
OCR_SERVICE_URL="http://localhost:8000"

# Local Ollama (Qwen3 4B, 4-bit)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="qwen3:4b"

# Private receipt storage (local disk for the student MVP)
STORAGE_DIR="./storage/receipts"
