generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  name            String?
  password        String?
  image           String?
  monthlyBudget   Decimal?  @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  financialAccounts FinancialAccount[]
  receipts          Receipt[]
  transactions      Transaction[]
  budgets           Budget[]
  notifications     Notification[]
  aiInsights        AIInsight[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum AccountType {
  BANK
  CREDIT_CARD
  DEBIT_CARD
  SAVINGS
  OTHER
}

enum CardNetwork {
  VISA
  MASTERCARD
  AMEX
  DISCOVER
  OTHER
}

model FinancialAccount {
  id              String       @id @default(cuid())
  userId          String
  accountType     AccountType
  institutionName String
  accountName     String
  lastFourDigits  String?      @db.Char(4)
  cardNetwork     CardNetwork?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardBenefits CardBenefit[]
  transactions Transaction[]

  @@index([userId])
}

enum BenefitSource {
  VERIFIED
  USER_ENTERED
  AI_SUGGESTED
}

enum RewardType {
  CASHBACK
  POINTS
  MILES
}

model CardBenefit {
  id                 String        @id @default(cuid())
  financialAccountId String
  category           String
  rewardType         RewardType
  rewardRate         Decimal       @db.Decimal(5, 2)
  benefitSource      BenefitSource
  conditions         String?
  verifiedAt         DateTime?
  createdAt          DateTime      @default(now())

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  @@index([financialAccountId])
}

model Category {
  id               String    @id @default(cuid())
  userId           String?
  name             String
  icon             String?
  color            String?
  parentCategoryId String?
  isSystem         Boolean   @default(false)
  createdAt        DateTime  @default(now())

  parentCategory   Category?       @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  childCategories  Category[]      @relation("CategoryHierarchy")
  transactions     Transaction[]
  transactionItems TransactionItem[]
  budgets          Budget[]

  @@index([userId])
  @@index([isSystem])
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Receipt {
  id                   String           @id @default(cuid())
  userId               String
  storageKey           String
  originalFilename     String?
  mimeType             String?
  fileSizeBytes        Int?
  processingStatus     ProcessingStatus @default(PENDING)
  rawExtraction        Json?
  extractionConfidence Decimal?         @db.Decimal(3, 2)
  createdAt            DateTime         @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?

  @@index([userId])
  @@index([processingStatus])
}

enum PaymentMethodConfidence {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum TransactionSource {
  RECEIPT
  MANUAL
  BANK_SYNC
}

model Transaction {
  id                       String                   @id @default(cuid())
  userId                   String
  receiptId                String?                  @unique
  financialAccountId       String?
  categoryId               String?
  merchantName             String
  merchantAddress          String?
  transactionDate          DateTime                 @db.Date
  transactionTime          DateTime?                @db.Time
  subtotal                 Decimal?                 @db.Decimal(12, 2)
  taxAmount                Decimal?                 @db.Decimal(12, 2)
  tipAmount                Decimal?                 @db.Decimal(12, 2)
  totalAmount              Decimal                  @db.Decimal(12, 2)
  currency                 String                   @default("USD") @db.Char(3)
  paymentMethodConfidence  PaymentMethodConfidence  @default(UNKNOWN)
  notes                    String?
  isRecurring              Boolean                  @default(false)
  source                   TransactionSource        @default(RECEIPT)
  bankTransactionId        String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipt          Receipt?          @relation(fields: [receiptId], references: [id])
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  category         Category?         @relation(fields: [categoryId], references: [id])
  items            TransactionItem[]

  @@index([userId])
  @@index([userId, transactionDate])
  @@index([userId, categoryId])
  @@index([userId, merchantName])
}

model TransactionItem {
  id            String   @id @default(cuid())
  transactionId String
  description   String
  quantity      Decimal  @default(1) @db.Decimal(10, 3)
  unitPrice     Decimal? @db.Decimal(12, 2)
  totalPrice    Decimal  @db.Decimal(12, 2)
  categoryId    String?
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id])

  @@index([transactionId])
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

model Budget {
  id         String       @id @default(cuid())
  userId     String
  categoryId String?
  periodType BudgetPeriod @default(MONTHLY)
  amount     Decimal      @db.Decimal(12, 2)
  startDate  DateTime?    @db.Date
  endDate    DateTime?    @db.Date
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([userId, categoryId])
}

enum NotificationType {
  SPENDING_ALERT
  BUDGET_WARNING
  INSIGHT
  SYSTEM
}

model Notification {
  id               String           @id @default(cuid())
  userId           String
  notificationType NotificationType
  title            String
  message          String
  data             Json?
  isRead           Boolean          @default(false)
  deliveredAt      DateTime?
  deliveryChannels Json?
  createdAt        DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model AIInsight {
  id              String    @id @default(cuid())
  userId          String
  insightType     String
  title           String
  content         String
  relatedData     Json?
  confidenceScore Decimal?  @db.Decimal(3, 2)
  isDismissed     Boolean   @default(false)
  validUntil      DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDismissed])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
